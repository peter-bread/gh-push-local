################################################################################

# Push current local repository to GitHub.
#
# 1. Get the full path of the currently checked out git repository.
# 2. Create a GitHub repository
#   a. on the currently authenticated user's GitHub account
#   b. with the repo name set to the basename of the local repo
#   c. with private visibility

################################################################################

# TODO: Validate OPT_OWNER

################################################################################

set -e

show_help() {
  echo "Push current local repository to GitHub"
  echo
  echo "USAGE"
  echo "  gh push-local [<options>]"
  echo
  echo "OPTIONS"
  echo "  --owner <owner>       Owner or organisation the repository should be created under"
  echo "  --visibility <value>  Repository visibility (allowed: private|public|internal) (default: private)"
  echo "  --dry-run             Don't actually do anything; prints the command that would be invoked"
  echo "  -h, --help            Print this help message"
}

flag() {
  [[ $1 -eq 1 ]]
}

: "${OPT_OWNER:=}"
: "${OPT_VISIBILITY:=private}"
: "${OPT_DRY_RUN:=0}"

while [ $# -gt 0 ]; do
  case $1 in
  --owner)
    OPT_OWNER=$2
    shift
    ;;
  --visibility)
    OPT_VISIBILITY=$2
    shift
    ;;
  --dry-run)
    OPT_DRY_RUN=1
    ;;
  -h | --help)
    show_help
    exit 0
    ;;
  *)
    echo "Invalid option: $1"
    exit 1
    ;;
  esac
  shift
done

case $OPT_VISIBILITY in
private | public | internal) ;;
*)
  echo "Invalid argument provided to --visibility: $OPT_VISIBILITY"
  echo "Allowed values: public, private, internal"
  exit 1
  ;;
esac

main() {
  REPO=$(git rev-parse --show-toplevel)

  NAME=${OPT_OWNER:+$OPT_OWNER/}$(basename "$REPO")
  VISIBILITY="--$OPT_VISIBILITY"

  CMD=(gh repo create "$NAME" --push --source "$REPO" "$VISIBILITY")

  echo "${CMD[@]}"

  # If we are doing a dry run, exit before executing the command.
  flag "$OPT_DRY_RUN" && exit

  exec "${CMD[@]}"
}

main
